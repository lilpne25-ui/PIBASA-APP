# Copia a .env y rellena SOLO con valores locales. Nunca subas .env.

# Base de datos (PostgreSQL). Local: ver docker-compose.yml
DATABASE_URL="postgresql://pibasa:pibasa_local_dev@localhost:5432/pibasa?schema=public"

# Autenticacion. Genera con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="<GENERA_MINIMO_32_CARACTERES>"
# "1" en produccion (HTTPS). Cookie Secure.
AUTH_SECURE_COOKIE="0"

# Solo para `npm run db:seed` (crea el primer ADMIN). No hay credenciales por defecto.
SEED_ADMIN_EMAIL="<correo-admin>"
SEED_ADMIN_NAME="Administrador"
SEED_ADMIN_PASSWORD="<minimo-12-caracteres>"

# WhatsApp (Meta Cloud API). Se usa a partir de los atomos 6 y 12; en el atomo 1 no se lee.
WHATSAPP_PROVIDER="mock"
WHATSAPP_VERIFY_TOKEN="<SECRETO>"
WHATSAPP_ACCESS_TOKEN="<SECRETO>"
WHATSAPP_PHONE_NUMBER_ID="<ID>"
META_APP_SECRET="<SECRETO>"
